# Copy to .env.local. These are read by Next.js.
# `npx convex dev` writes the two Convex values for you.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk dashboard > API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The values below are NOT read from this file. Convex functions only see
# variables set on the deployment, so set them with `npx convex env set NAME value`:
#
# CLERK_JWT_ISSUER_DOMAIN   Clerk Frontend API URL, e.g. https://verb-noun-00.clerk.accounts.dev
# ADMIN_EMAILS              Comma-separated emails made admin on first sign-in
