{
  "id": "LendLoopNotify01",
  "name": "LendLoop request notification",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "LendLoopErrors01"
  },
  "pinData": {},
  "nodes": [
    {
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Loan event webhook",
      "position": [
        0,
        300
      ],
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "webhookId": "lendloop-notification",
      "parameters": {
        "httpMethod": "POST",
        "path": "lendloop-notification",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Verify signature",
      "position": [
        240,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Checks the signature over the exact bytes received, before trusting anything.\nconst crypto = require('crypto');\nconst MAX_AGE_SECONDS = 300;\n\nconst secret = $env.LENDLOOP_WEBHOOK_SECRET;\nconst headers = $input.first().json.headers ?? {};\nconst timestamp = headers['x-lendloop-timestamp'] ?? '';\nconst signature = headers['x-lendloop-signature'] ?? '';\nconst rawBody = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n\nconst age = Math.abs(Math.floor(Date.now() / 1000) - Number(timestamp));\nconst isFresh = /^\\d+$/.test(timestamp) && age <= MAX_AGE_SECONDS;\n\nconst expected = crypto\n  .createHmac('sha256', secret ?? '')\n  .update(`${timestamp}.${rawBody}`)\n  .digest();\nconst received = Buffer.from(String(signature), 'hex');\n\n// timingSafeEqual throws on different lengths, so check that first.\nconst isMatch =\n  received.length === expected.length && crypto.timingSafeEqual(received, expected);\n\n// A missing secret fails closed.\nconst isValid = Boolean(secret) && isFresh && isMatch;\nreturn [{ json: isValid ? { isValid, event: JSON.parse(rawBody) } : { isValid } }];"
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Signature valid?",
      "position": [
        480,
        300
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "a1000000-0000-4000-8000-0000000000c1",
              "leftValue": "={{ $json.isValid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Respond 200",
      "position": [
        720,
        200
      ],
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"received\": true } }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Respond 401",
      "position": [
        720,
        420
      ],
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": \"Invalid signature\" } }}",
        "options": {
          "responseCode": 401
        }
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Mock notification",
      "position": [
        960,
        200
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Stands in for a real provider. The log leaves out the email address.\nconst { event } = $('Verify signature').first().json;\n\nconst MESSAGES = {\n  pending: 'has a new borrow request for',\n  approved: 'had their request approved for',\n  declined: 'had their request declined for',\n  cancelled: 'had a request cancelled for',\n  returned: 'has a completed loan of',\n};\nconst message = `${event.recipient.firstName} ${MESSAGES[event.status]} ${event.toolName} (${event.startDate} to ${event.endDate})`;\n\nconsole.log(`[mock notification] ${event.eventId}: ${message}`);\nreturn [{ json: { message } }];"
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Send email (optional)",
      "position": [
        1200,
        200
      ],
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "disabled": true,
      "notes": "Optional. Enable it and attach an SMTP credential to send real email.",
      "parameters": {
        "fromEmail": "lendloop@example.com",
        "toEmail": "={{ $('Verify signature').first().json.event.recipient.email }}",
        "subject": "=LendLoop: an update on {{ $('Verify signature').first().json.event.toolName }}",
        "emailFormat": "text",
        "text": "={{ $('Mock notification').first().json.message }}",
        "options": {}
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Sign write-back",
      "position": [
        1440,
        200
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nfunction signed(body) {\n  const rawBody = JSON.stringify(body);\n  const timestamp = String(Math.floor(Date.now() / 1000));\n  const signature = crypto\n    .createHmac('sha256', $env.LENDLOOP_WEBHOOK_SECRET)\n    .update(`${timestamp}.${rawBody}`)\n    .digest('hex');\n  return { rawBody, timestamp, signature };\n}\n\nconst { event } = $('Verify signature').first().json;\nreturn [{ json: signed({\n  loanId: event.loanId,\n  loanStatus: event.status,\n  status: 'sent',\n}) }];"
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Write back to Convex",
      "position": [
        1680,
        200
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/n8n/notification-status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-LendLoop-Timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "X-LendLoop-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.rawBody }}",
        "options": {
          "timeout": 10000
        }
      }
    }
  ],
  "connections": {
    "Loan event webhook": {
      "main": [
        [
          {
            "node": "Verify signature",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify signature": {
      "main": [
        [
          {
            "node": "Signature valid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Signature valid?": {
      "main": [
        [
          {
            "node": "Respond 200",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond 401",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Respond 200": {
      "main": [
        [
          {
            "node": "Mock notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mock notification": {
      "main": [
        [
          {
            "node": "Send email (optional)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send email (optional)": {
      "main": [
        [
          {
            "node": "Sign write-back",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign write-back": {
      "main": [
        [
          {
            "node": "Write back to Convex",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
