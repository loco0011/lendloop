{
  "id": "LendLoopOverdue1",
  "name": "LendLoop overdue reminders",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "LendLoopErrors01"
  },
  "pinData": {},
  "nodes": [
    {
      "id": "b1000000-0000-4000-8000-000000000001",
      "name": "Every day at 08:00",
      "position": [
        0,
        300
      ],
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 8
            }
          ]
        }
      }
    },
    {
      "id": "b1000000-0000-4000-8000-000000000002",
      "name": "Sign request",
      "position": [
        240,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// A GET has no body, so the signature covers the timestamp and an empty string.\nconst crypto = require('crypto');\n\nconst timestamp = String(Math.floor(Date.now() / 1000));\nconst signature = crypto\n  .createHmac('sha256', $env.LENDLOOP_WEBHOOK_SECRET)\n  .update(`${timestamp}.`)\n  .digest('hex');\n\nreturn [{ json: { timestamp, signature } }];"
      }
    },
    {
      "id": "b1000000-0000-4000-8000-000000000003",
      "name": "Fetch overdue loans",
      "position": [
        480,
        300
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/n8n/overdue-loans",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-LendLoop-Timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "X-LendLoop-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "b1000000-0000-4000-8000-000000000004",
      "name": "One item per loan",
      "position": [
        720,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// No overdue loans means no items, so the workflow ends here.\nreturn $input.first().json.loans.map((loan) => ({ json: loan }));"
      }
    },
    {
      "id": "b1000000-0000-4000-8000-000000000005",
      "name": "Mock reminder",
      "position": [
        960,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Stands in for a real provider. The log leaves out the email address.\nreturn $input.all().map(({ json: loan }) => {\n  const message = `Hi ${loan.borrowerFirstName}, ${loan.toolName} was due back on ${loan.dueDate}. Please return it when you can.`;\n  console.log(`[mock reminder] loan ${loan.loanId}: ${message}`);\n  return { json: { ...loan, message } };\n});"
      }
    },
    {
      "id": "b1000000-0000-4000-8000-000000000006",
      "name": "Send email (optional)",
      "position": [
        1200,
        300
      ],
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "disabled": true,
      "notes": "Optional. Enable it and attach an SMTP credential to send real email.",
      "parameters": {
        "fromEmail": "lendloop@example.com",
        "toEmail": "={{ $json.borrowerEmail }}",
        "subject": "=LendLoop: {{ $json.toolName }} is overdue",
        "emailFormat": "text",
        "text": "={{ $json.message }}",
        "options": {}
      }
    },
    {
      "id": "b1000000-0000-4000-8000-000000000007",
      "name": "Sign write-backs",
      "position": [
        1440,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nfunction signed(body) {\n  const rawBody = JSON.stringify(body);\n  const timestamp = String(Math.floor(Date.now() / 1000));\n  const signature = crypto\n    .createHmac('sha256', $env.LENDLOOP_WEBHOOK_SECRET)\n    .update(`${timestamp}.${rawBody}`)\n    .digest('hex');\n  return { rawBody, timestamp, signature };\n}\n\n// Reads from the reminder node, because an enabled email node replaces the data.\nreturn $('Mock reminder').all().map(({ json: loan }) => ({\n  json: signed({ loanId: loan.loanId, status: 'sent' }),\n}));"
      }
    },
    {
      "id": "b1000000-0000-4000-8000-000000000008",
      "name": "Write back to Convex",
      "position": [
        1680,
        300
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/n8n/reminder-status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-LendLoop-Timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "X-LendLoop-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.rawBody }}",
        "options": {
          "timeout": 10000
        }
      }
    }
  ],
  "connections": {
    "Every day at 08:00": {
      "main": [
        [
          {
            "node": "Sign request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign request": {
      "main": [
        [
          {
            "node": "Fetch overdue loans",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch overdue loans": {
      "main": [
        [
          {
            "node": "One item per loan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per loan": {
      "main": [
        [
          {
            "node": "Mock reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mock reminder": {
      "main": [
        [
          {
            "node": "Send email (optional)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send email (optional)": {
      "main": [
        [
          {
            "node": "Sign write-backs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign write-backs": {
      "main": [
        [
          {
            "node": "Write back to Convex",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
