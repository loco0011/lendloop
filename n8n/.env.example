# Copy to n8n/.env. Docker Compose reads it automatically.

# Encrypts credentials stored in n8n. Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Must equal LENDLOOP_WEBHOOK_SECRET on the Convex deployment.
LENDLOOP_WEBHOOK_SECRET=

# Where n8n reaches Convex HTTP actions, without a trailing slash.
# Local Convex deployment: http://host.docker.internal:3211
# Cloud Convex deployment: https://<your-deployment>.convex.site
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211

# Timezone for the daily schedule.
TIMEZONE=UTC
